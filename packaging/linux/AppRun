#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "${0%/*}" && pwd)}
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export MYGO_ENV=production
export CURB_BUNDLED_RUNTIME=1
export CURB_ORIGINAL_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
export CURB_RUNTIME_LIBDIR="$APPDIR/usr/lib"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export FONTCONFIG_FILE="$APPDIR/usr/etc/fonts/fonts.conf"
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
export GTK_IM_MODULE_FILE="$APPDIR/usr/lib/immodules.cache"
export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib/pixbuf.cache"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
exec "$APPDIR/usr/bin/curb" "$@"
